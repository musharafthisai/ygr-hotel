{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "Dockerfile",
      "docker-compose.yml",
      "cloudbuild.yaml"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.php"
      }
    ]
  }
}
