{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "Dockerfile",
      "docker-compose.yml",
      "cloudbuild.yaml"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "ygr-hotel",
          "region": "us-central1"
        }
      }
    ]
  }
}
