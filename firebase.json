{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "Dockerfile",
      "docker-compose.yml",
      "cloudbuild.yaml",
      "*.php",
      "**/*.php"
    ],
    "redirects": [
      {
        "source": "*.php",
        "destination": "/index.html",
        "type": 302
      },
      {
        "source": "**/*.php",
        "destination": "/index.html",
        "type": 302
      }
    ]
  }
}
